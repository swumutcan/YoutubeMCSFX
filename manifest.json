{
  "manifest_version": 3,
  "name": "YouTube Music SFX - Audio Reactive Background",
  "version": "1.0.0",
  "description": "Müziğin ritmine, baslarına ve albüm kapağına göre dinamik ve akıcı arka plan oluşturan YouTube Music eklentisi.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "YouTube Music SFX Ayarları"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "css": ["content/style.css"],
      "js": ["content/bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content/visualizer.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/*", "icons/*"],
      "matches": ["*://music.youtube.com/*"]
    }
  ]
}
